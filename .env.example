# ==============================================================================
# PashuSetu Environment Variables Template (Production & Development)
# NOTE: DO NOT put real passwords, keys, or secrets in this template.
# ==============================================================================

# Backend Database Connection (Managed PostgreSQL: Neon, Supabase, Railway, Render)
DATABASE_URL=

# Backend Server Configuration
PORT=
NODE_ENV=
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS & Frontend Origins
FRONTEND_URL=
CORS_ORIGIN=

# Frontend Configuration (Vite)
VITE_API_URL=

# Persistent Object Storage for Animal & Health Photos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
