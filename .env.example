# ==============================================================================
# PashuSetu Environment Variables Template (Production & Development)
# NOTE: DO NOT put real passwords, keys, or secrets in this template.
# ==============================================================================

# Backend Database Connection (Supabase PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Backend Server Configuration (Railway automatically sets PORT)
PORT=
NODE_ENV=
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS & Frontend Origins (Netlify deployed domain)
FRONTEND_URL=
CORS_ORIGIN=

# Frontend Configuration (Vite - points to Railway backend domain)
VITE_API_URL=

# Supabase Storage for Animal & Health Photos (Persistent Cloud Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional Cloudinary Configuration (Alternative storage provider)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
